{
  "name": "live-vote-board",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:release": "node tests/release.mjs",
    "db:local": "wrangler d1 migrations apply vote-board --local",
    "worker:dev": "wrangler dev --local --port 8787",
    "worker:deploy": "node scripts/preflight.mjs && wrangler deploy",
    "package": "node scripts/package.mjs",
    "test:editor": "node tests/editor-browser.mjs",
    "test:inspector": "node tests/inspector-browser.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "playwright": "1.62.1",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.28.2": true
  }
}
